# ===== Servidor =====
PORT=3000

# ===== Base de datos =====
MONGODB_URI=mongodb://localhost:27017/crm

# ===== Seguridad =====
# CLAVE SECRETA PARA JWT (CAMBIALA OBLIGATORIAMENTE)
JWT_SECRET=clave_secreta_super_segura_123

# ===== Meta / WhatsApp =====
# Token de acceso de WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=EAAG...
# App Secret de Meta (para validar firma del webhook)
WHATSAPP_APP_SECRET=...
# Token que configuraste en Meta para verificar el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...
# WABA ID global (opcional, puede guardarse por empresa)
WHATSAPP_WABA_ID=

# ===== IA (Gemini) =====
GEMINI_API_KEY=AIza...
# Modelos permitidos, separados por coma (opcional)
GEMINI_MODELOS=gemini-2.0-flash,gemini-1.5-flash

# ===== CORS =====
# Dominios permitidos separados por coma. NUNCA dejar * en producción.
CORS_ORIGIN=https://panel.midominio.com

# ===== Fallbacks de IA (opcionales) =====
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
